{
  "expo": {
    "name": "Griya AnDari",
    "slug": "Griya-AnDari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-griya-andari_putih.png",
    "scheme": "feandari",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo-griya-andari_putih.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2B4C",
        "foregroundImage": "./assets/images/logo-griya-andari_putih.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A2B4C",
          "image": "./assets/images/logo-griya-andari_putih.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
